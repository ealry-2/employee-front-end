# Production API endpoint
VITE_API_BASE_URL=https://api.il-log.com

# Local development can use the Vite proxy instead of direct CORS calls.
# Example:
# VITE_API_BASE_URL=/illog-api
# VITE_DEV_PROXY_TARGET=https://api.il-log.com

# Frontend-only employee app preview. Vite exposes this only in dev, and the
# app code also requires import.meta.env.DEV before returning demo responses.
# VITE_EMPLOYEE_APP_DEMO=true
